[Unit]
Description=SysPiper - Hardened
After=network-online.target

[Service]
User=syspiper
Group=syspiper
Environment=IP_PORT=0.0.0.0:8181
ExecStart=/bin/bash -c 'exec .venv/bin/gunicorn -w 4 -b ${IP_PORT} wsgi:app --access-logfile - --error-logfile -'

# If VRF is needed - use override via `systemctl edit syspiper`
# [Service]
# User=syspiper
# ExecStart=
# ExecStart=/usr/sbin/ip vrf exec blue .venv/bin/gunicorn -w 4 -b ${IP_PORT} wsgi:app --access-logfile - --error-logfile -
# ProtectSystem=full
# ReadWritePaths=/sys/fs/cgroup/system.slice/syspiper.service
# ProtectControlGroups=no
# Delegate=yes
# RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK

WorkingDirectory=/opt/syspiper/self
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# --- HARDENING ---

# Filesystem protection
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/syspiper/self

# Kernel protection
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

# Process sandboxing
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6

# Memory protection
MemoryDenyWriteExecute=yes

# No capabilities are needed for the default unprivileged port.
# VRF deployments need an explicit, separately reviewed override.
CapabilityBoundingSet=
AmbientCapabilities=

# Other safety
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes

[Install]
WantedBy=multi-user.target

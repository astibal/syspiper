[Unit]
Description=SysPiper - Hardened
After=network-online.target

[Service]
Environment=IP_PORT=0.0.0.0:8181
ExecStart=/bin/bash -c 'exec .venv/bin/gunicorn -w 4 -b ${IP_PORT} wsgi:app --access-logfile - --error-logfile -'

# If VRF is needed
# ExecStart=/bin/bash -c 'exec /usr/sbin/ip vrf exec vrf-blue .venv/bin/gunicorn -w 4 -b ${IP_PORT} wsgi:app --access-logfile - --error-logfile -'

WorkingDirectory=/opt/syspiper/self
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# --- HARDENING ---

# Filesystem protection
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadPaths=/opt/syspiper/self

# Kernel protection
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

# Process sandboxing
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6

# Memory protection
MemoryDenyWriteExecute=yes

# Capabilities (minimum necessary)
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_SYS_ADMIN

# Other safety
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes

[Install]
WantedBy=multi-user.target
